# Multi-Model Arena — API key template
# 이 파일을 복사하여 워크스페이스 루트에 ".env"라는 이름으로 저장한 뒤,
# 실제 키 값을 채워주세요.
#
# 절대 .env 파일을 git에 커밋하지 마세요. (.gitignore에 등록됨)

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-5.5
# reasoning_effort 옵션: minimal | low | medium | high
OPENAI_REASONING_EFFORT=high

# --- Google Gemini ---
GOOGLE_API_KEY=AIza-your-google-key-here
GOOGLE_MODEL=gemini-3.1
# Gemini deep think 활성화 (true|false)
GOOGLE_DEEP_THINK=true

# --- 공통 옵션 ---
# fallback 모델 (최신 모델 미가용 시 사용)
OPENAI_FALLBACK_MODEL=gpt-4.1
GOOGLE_FALLBACK_MODEL=gemini-2.5-pro

# 비용 한도 (USD, 1회 arena 실행당)
ARENA_MAX_COST_USD=2.00

# 결과 저장 위치
ARENA_OUTPUT_DIR=./arena_results
